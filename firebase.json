{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", ".firebaserc"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**/*.@(js|css|svg|png|jpg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
